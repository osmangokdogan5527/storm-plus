{
  "name": "storm-plus",
  "author": "Osman Gökdoğan",
  "description": "Ön Muhasebe ve Stok Takip Programı",
  "private": true,
  "version": "1.3.9",
  "type": "module",
  "main": "electron-main.cjs",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "electron:dev": "electron .",
    "electron:start": "concurrently \"npm run dev\" \"electron .\"",
    "electron:build": "vite build && electron-builder --win"
  },
  "build": {
    "appId": "com.stormplus.app",
    "productName": "Storm Plus",
    "compression": "maximum",
    "npmRebuild": true,
    "buildDependenciesFromSource": true,
    "win": {
      "icon": "public/icon.ico",
      "artifactName": "Storm.Plus.Setup.${version}.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {},
    "linux": {},
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Storm Plus",
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "perMachine": true
    },
    "files": [
      "dist/**/*",
      "electron-main.cjs",
      "preload.js",
      "package.json"
    ],
    "directories": {
      "output": "dist-electron"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "osmangokdogan5527",
        "repo": "storm-plus"
      }
    ]
  },
  "dependencies": {
    "@types/jszip": "^3.4.1",
    "electron-updater": "^6.8.9",
    "html2canvas": "^1.4.1",
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^10.0.3",
    "electron": "^42.5.0",
    "electron-builder": "^26.15.3",
    "firebase": "^12.15.0",
    "html-to-image": "^1.11.13",
    "html5-qrcode": "^2.3.8",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.42.2",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-barcode": "^1.6.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.9.0",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "xlsx": "^0.18.5"
  }
}
